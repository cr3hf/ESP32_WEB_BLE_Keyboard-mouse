# ---------------- LED (原有配置，保持不变) ----------------
CONFIG_BLINK_LED_STRIP=y
CONFIG_BLINK_GPIO=1

# ---------------- Flash 与分区表 ----------------
# 一份配置兼容 N4R2(4MB) 与 N16R8(16MB)：Flash 必须按较小规格(4MB)配置，
# 否则 4MB 板烧录会越界。N16R8 物理 16MB 但用 4MB 配置完全能跑（固件不超 4MB）。
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=n
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="main/partitions_ota.csv"

# ---------------- PSRAM（Quad 模式通吃 N4R2 / N16R8） ----------------
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
# 注意：ESP-IDF v5.3.5 的 SPIRAM_MODE 是互斥 choice，无"自动探测"选项。
# 为一份固件兼容两种板，统一用 Quad 模式：
#   - N4R2 原生即为 Quad PSRAM，直接用；
#   - N16R8 的 Octal PSRAM 硬件上兼容 Quad 模式（降级运行，带宽减半但本工程负载无感）。
# 若某批次 N16R8 模组 Quad 模式初始化失败，下面 IGNORE_NOTFOUND 兜底退回内部 SRAM，
# 主功能 HID 仍可用（仅 web_server 等重内存功能可能受限）。
CONFIG_SPIRAM_MODE_QUAD=y
# CONFIG_SPIRAM_MODE_OCT is not set
CONFIG_SPIRAM_TYPE_AUTO=y
# 外部 PSRAM 初始化失败时退回内部 SRAM 继续运行（不死），保证主功能 HID 不挂
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# 不把 .bss/.data 全丢 PSRAM，关键栈仍留内部，保持稳定
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=n
# WiFi/HTTP 缓冲允许使用 PSRAM（仅在 PSRAM 实际起来后生效）
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# ---------------- WiFi（SoftAP 常开 + 可选 STA 共存） ----------------
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_ESP_NETIF_IPLV4=y
CONFIG_ESP_NETIF_TCPIP_LWIP=y
CONFIG_ESP_HTTP_SERVER=y
CONFIG_ESP_HTTP_SERVER_PORT=80
CONFIG_ESP_HTTP_SERVER_MAX_URI_HANDLERS=12
# 增大 HTTP 请求头缓冲，兼容手机浏览器长请求头（避免 431 Request Header Fields Too Large）
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# ---------------- SNTP（STA 连上路由器后校时，供定时任务） ----------------
CONFIG_SNTP=y

# ---------------- 蓝牙 (BLE HID) ----------------
# ESP32-S3 不支持经典蓝牙(BR/EDR)，仅启用 BLE + Bluedroid
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_GATTS_ENABLE=y
# 蓝牙默认发射功率降档（N3=-3dBm），近距离 5M 足够，降低发热
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_N3=y

# ---------------- 编译优化 ----------------
# 优化固件体积
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ---------------- LWIP（跨网段/端口映射访问可靠性） ----------------
# 默认 TCP MSS=1440。经 NAT/端口映射回传 65KB 单页时，若外网路径 MTU<1440(常见 PPPoE/隧道/手机热点)，
# 大段被丢弃且 PMTUD 被 NAT 屏蔽 → 对端收不到 → 响应 RST(ECONNRESET)，表现为外部能连上但页面发不回来。
# 降到 536(RFC 最小安全值，兼容任何路径 MTU>=576) 彻底规避该问题；代价是外网吞吐略降，本地/AP 直连无感。
CONFIG_LWIP_TCP_MSS=536
# HTTP 服务内部固定占 3 个 socket，max_open_sockets 上限 = LWIP_MAX_SOCKETS - 3。
# web_server.c 当前用 max_open_sockets=7(默认 LWIP_MAX_SOCKETS=10 → 上限 7，用户 4 路)，增量编译即可通过。
# 若执行 Full Clean 重新生成 sdkconfig，本行 LWIP_MAX_SOCKETS=16 生效 → 上限 13，届时可把 max_open_sockets 提到 9(用户 6 路)。
CONFIG_LWIP_MAX_SOCKETS=16
